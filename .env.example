# Admin access key for the /admin dashboard
ADMIN_KEY=change-this-admin-key

# Optional: MongoDB Atlas Connection string for cloud persistence on Vercel
# If not provided, the app will use temporary storage on Vercel or local JSON file locally
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hccda_ai

# Port for local development
PORT=3000
